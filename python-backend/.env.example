# ─── Environment ─────────────────────────────────────────────────────────────
ENV=development

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8000

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (same DB as Next.js frontend)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Auth (Clerk) ────────────────────────────────────────────────────────────
# Your Clerk frontend API domain — found in Clerk dashboard → Domains
# Format: <your-app>.clerk.accounts.dev  (dev) or your custom domain (prod)
CLERK_DOMAIN=your-app.clerk.accounts.dev

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3000

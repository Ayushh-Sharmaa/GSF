# ─── Clerk (Frontend Auth) ───────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → Your App → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk redirect paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ─── Database ────────────────────────────────────────────────────────────────
# Get from: Neon (neon.tech) or Supabase → Connection String
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ─── Python Backend ──────────────────────────────────────────────────────────
# URL of the deployed FastAPI backend (used by Next.js server actions/routes)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Email (Nodemailer) ──────────────────────────────────────────────────────
# SMTP credentials for transactional email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@email.com
EMAIL_PASS=your-app-password
EMAIL_FROM="GSF Platform <no-reply@gsf.community>"

# ─── Svix (Webhooks) ─────────────────────────────────────────────────────────
# Get from: https://svix.com → your app → API keys
SVIX_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── App URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
